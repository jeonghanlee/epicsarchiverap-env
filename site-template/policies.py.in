#
# This is the policies.py used to enforce policies for archiving PVs
# At a very high level, when users request PVs to be archived, the mgmt web app samples the PV to determine event rate and other parameters.
# In addition, various fields of the PV like .NAME, .ADEL, .MDEL, .RTYP etc are also obtained
# These are passed to this python script as a dictionary argument to a method called determinePolicy
# The variable name in the python environment for this information is 'pvInfo' (so use other variable names etc.).
# The method is expected to use this information to make decisions on various archiving parameters.
# The result is expected to be another dictionary that is placed into the variable called "pvPolicy".
# Optionally, fields in addition to the VAL field that are to be archived with the PV are passed in as a property of pvPolicy called 'archiveFields'
# If the user overrides the policy, this is communicated in the pvinfo as a property called 'policyName'
#
# In addition, this script must communicate the list of available policies to the JVM as another method called getPolicyList which takes no arguments.
# The results of this method is placed into a variable called called 'pvPolicies'.
# The dictionary is a name to description mapping - the description is used in the UI; the name is what is communicated to determinePolicy as a user override
#
# In addition, this script must communicate the list of fields that are to be archived as part of the stream in a method called getFieldsArchivedAsPartOfStream.
# The results of this method is placed into a list variable called called
# 'pvStandardFields'.


import sys
import os

# Generate a list of policy names. This is used to feed the dropdown in the UI.


def getPolicyList():
    pvPoliciesDict = {}
    pvPoliciesDict['Default'] = '1 Hz monitor'
    pvPoliciesDict['VeryFast'] = '10 hz monitor, LTS reduce to 10 sec, always archived'
    pvPoliciesDict['Fast'] = '1 hz monitor, LTS reduce to 30 sec, always archived'
    pvPoliciesDict['Medium'] = '10 sec monitor, LTS reduce to 60 sec, always archived'
    pvPoliciesDict['Slow'] = '60 sec scan, LTS reduce to 180 sec, always archived'
    pvPoliciesDict['VerySlow'] = '15 min scan, No LTS reduce, always archived'
    pvPoliciesDict['VeryFastControlled'] = '10 hz monitor, LTS reduce to 10 sec, archived based on PV status'
    pvPoliciesDict['FastControlled'] = '1 hz monitor, LTS reduce to 30 sec, archived based on PV status'
    pvPoliciesDict['MediumControlled'] = '10 sec monitor, LTS reduce to 60 sec, archived based on PV status'
    pvPoliciesDict['SlowControlled'] = '60 sec scan, LTS reduce to 180 sec, archived based on PV status'
    pvPoliciesDict['VerySlowControlled'] = '15 min scan, No LTS reduce, archived based on PV status'
    return pvPoliciesDict


# Define a list of fields that will be archived as part of every PV.
# The data for these fields will included in the stream for the PV.
# We also make an assumption that the data type for these fields is the
# same as that of the .VAL field
def getFieldsArchivedAsPartOfStream():
    return ['HIHI', 'HIGH', 'LOW', 'LOLO', 'LOPR', 'HOPR', 'DRVH', 'DRVL']


# We use the environment variables ARCHAPPL_SHORT_TERM_FOLDER and
# ARCHAPPL_MEDIUM_TERM_FOLDER to determine the location of the STS and the
# MTS in the appliance
STS_BASE_URL = 'pb://@ARCHAPPL_HOST_IPADDR@?name=STS&rootFolder=@ARCHAPPL_SHORT_TERM_FOLDER@&partitionGranularity=PARTITION_HOUR&hold=2&gather=1&consolidateOnShutdown=true'
MTS_BASE_URL = 'pb://@ARCHAPPL_HOST_IPADDR@?name=MTS&rootFolder=@ARCHAPPL_MEDIUM_TERM_FOLDER@&partitionGranularity=PARTITION_MONTH&hold=2&gather=1'
LTS_BASE_URL = 'pb://@ARCHAPPL_HOST_IPADDR@?name=LTS&rootFolder=@ARCHAPPL_LONG_TERM_FOLDER@&partitionGranularity=PARTITION_YEAR'


default_sts_plugin_url = '%s' % (STS_BASE_URL)
default_mts_plugin_url = '%s' % (MTS_BASE_URL)
default_lts_plugin_url = '%s' % (LTS_BASE_URL)

veryfast_sts_plugin_url = '%s' % (STS_BASE_URL)
veryfast_mts_plugin_url = '%s' % (MTS_BASE_URL)
veryfast_lts_plugin_url = '%s&reducedata=lastSample_10' % (LTS_BASE_URL)

fast_sts_plugin_url = '%s' % (STS_BASE_URL)
fast_mts_plugin_url = '%s' % (MTS_BASE_URL)
fast_lts_plugin_url = '%s&reducedata=lastSample_30' % (LTS_BASE_URL)

medium_sts_plugin_url = '%s' % (STS_BASE_URL)
medium_mts_plugin_url = '%s' % (MTS_BASE_URL)
medium_lts_plugin_url = '%s&reducedata=lastSample_60' % (LTS_BASE_URL)

slow_sts_plugin_url = '%s' % (STS_BASE_URL)
slow_mts_plugin_url = '%s' % (MTS_BASE_URL)
slow_lts_plugin_url = '%s&reducedata=lastSample_180' % (LTS_BASE_URL)

veryslow_sts_plugin_url = '%s' % (STS_BASE_URL)
veryslow_mts_plugin_url = '%s' % (MTS_BASE_URL)
veryslow_lts_plugin_url = '%s' % (LTS_BASE_URL)


def determinePolicy(pvInfoDict):
    pvPolicyDict = {}

    userPolicyOverride = ''
    if 'policyName' in pvInfoDict:
        userPolicyOverride = pvInfoDict['policyName']

    if 'Controlled' in userPolicyOverride:
        pvPolicyDict['controlPV'] = 'ALS:Archiver:Enable'

    if 'VeryFast' in userPolicyOverride:
        pvPolicyDict['samplingPeriod'] = 0.1
        pvPolicyDict['samplingMethod'] = 'MONITOR'
        pvPolicyDict['dataStores'] = [
            veryfast_sts_plugin_url,
            veryfast_mts_plugin_url,
            veryfast_lts_plugin_url
        ]
    elif 'Fast' in userPolicyOverride:
        pvPolicyDict['samplingPeriod'] = 1.0
        pvPolicyDict['samplingMethod'] = 'MONITOR'
        pvPolicyDict['dataStores'] = [
            fast_sts_plugin_url,
            fast_mts_plugin_url,
            fast_lts_plugin_url
        ]
    elif 'Medium' in userPolicyOverride:
        pvPolicyDict['samplingPeriod'] = 10.0
        pvPolicyDict['samplingMethod'] = 'MONITOR'
        pvPolicyDict['dataStores'] = [
            medium_sts_plugin_url,
            medium_mts_plugin_url,
            medium_lts_plugin_url
        ]
    elif 'VerySlow' in userPolicyOverride:
        pvPolicyDict['samplingPeriod'] = 900.0
        pvPolicyDict['samplingMethod'] = 'SCAN'
        pvPolicyDict['dataStores'] = [
            veryslow_sts_plugin_url,
            veryslow_mts_plugin_url,
            veryslow_lts_plugin_url
        ]
    elif 'Slow' in userPolicyOverride:
        pvPolicyDict['samplingPeriod'] = 60.0
        pvPolicyDict['samplingMethod'] = 'SCAN'
        pvPolicyDict['dataStores'] = [
            slow_sts_plugin_url,
            slow_mts_plugin_url,
            slow_lts_plugin_url
        ]
    elif 'Default' in userPolicyOverride:
        pvPolicyDict['samplingPeriod'] = 1.0
        pvPolicyDict['samplingMethod'] = 'MONITOR'
        pvPolicyDict['dataStores'] = [
            default_sts_plugin_url,
            default_mts_plugin_url,
            default_lts_plugin_url
        ]
    else:
        pvPolicyDict['samplingPeriod'] = 1.0
        pvPolicyDict['samplingMethod'] = 'MONITOR'
        pvPolicyDict['dataStores'] = [
            default_sts_plugin_url,
            default_mts_plugin_url,
            default_lts_plugin_url
        ]

    archiveFields = []

    if "RTYP" not in pvInfoDict:
        pvPolicyDict["archiveFields"] = archiveFields
    else:
        pvRTYP = pvInfoDict["RTYP"]
        if pvRTYP == "ai":
            archiveFields = [
                'HIHI', 
                'HIGH', 
                'LOW', 
                'LOLO', 
                'LOPR', 
                'HOPR']
        elif pvRTYP == "ao":
            archiveFields = [
                'HIHI',
                'HIGH',
                'LOW',
                'LOLO',
                'LOPR',
                'HOPR',
                'DRVH',
                'DRVL']
        elif pvRTYP == "calc":
            archiveFields = [
                'HIHI', 
                'HIGH', 
                'LOW', 
                'LOLO', 
                'LOPR', 
                'HOPR']
        elif pvRTYP == "calcout":
            archiveFields = [
                'HIHI', 
                'HIGH', 
                'LOW', 
                'LOLO', 
                'LOPR', 
                'HOPR']
        elif pvRTYP == "longin":
            archiveFields = [
                'HIHI', 
                'HIGH', 
                'LOW', 
                'LOLO', 
                'LOPR', 
                'HOPR']
        elif pvRTYP == "longout":
            archiveFields = [
                'HIHI',
                'HIGH',
                'LOW',
                'LOLO',
                'LOPR',
                'HOPR',
                'DRVH',
                'DRVL']
        elif pvRTYP == "dfanout":
            archiveFields = [
                'HIHI', 
                'HIGH', 
                'LOW', 
                'LOLO', 
                'LOPR', 
                'HOPR']
        elif pvRTYP == "sub":
            archiveFields = [
                'HIHI', 
                'HIGH', 
                'LOW', 
                'LOLO', 
                'LOPR', 
                'HOPR']
        elif pvRTYP == "motor":
            archiveFields = [
                'HIHI',
                'HIGH',
                'LOW',
                'LOLO',
                'LOPR',
                'HOPR',
                'VELO',
                'RBV']
        pvPolicyDict["archiveFields"] = archiveFields

    return pvPolicyDict


###### Parameter Settings ######
## name : One of them, each storage volume
    # STS : Short Term Storage (Temporary files)
    # MTS : Middle Term Storage (Temporary files)
    # LTS : Long Term Storage (Permanent files)

    # Note: 
    #   "Temporary" means that the pb file will be moved to the destination by the ETL module after the time elapses, 
    #   according to the "partitionGranularity" setting.

## consolidateOnShutdown
    # Often the STS is a RAMDisk, and thus has a consolidateOnShutdown attribute on the data store to move the data off the STS onto the MTS 
    #   when the appliance is being gracefully shutdown or the PV is being paused.
    # consolidateOnShutdown=true

## rootFolder :
    # The location of the top-level folder where each area should be saved.
    # You can set a different file system area to be mounted and used.

## partitionGranularity : 
    # Important parameter for the file transferring of ETL.
    # Defines the time index of the "pb" file to be created in each storage area.
    # Defines:
    #       PARTITION_5MIN(5 * 60)
    #       PARTITION_15MIN(15 * 60)
    #       PARTITION_30MIN(30 * 60)
    #       PARTITION_HOUR(60 * 60)
    #       PARTITION_DAY(24 * 60 * 60)
    #       PARTITION_MONTH( 31 * 24 * 60 * 60)
    #       PARTITION_YEAR( 366 * 24 * 60 * 60)

    # Note: 
    #   The pb generated file name is created based on UTC time.
    #   For example(PV, ApplTest:AN:F:Analog10), The prefix name corresponds to the directory path.
    #       -> ApplTest/AN/F/Analog10:partitionGranularity_time_index.pb
    #       -> ApplTest/AN/F/Analog10:2025_10_25_06_15.pb (STS, partitionGranularity=PARTITION_15MIN)
    #       -> ApplTest/AN/F/Analog10:2025_10_25_06.pb    (MTS, partitionGranularity=PARTITION_HOUR)
    #       -> ApplTest/AN/F/Analog10:2025_10.pb          (LTS, partitionGranularity=PARTITION_MONTH)
    #           : The area where the final files are collected becomes the LTS area

###### reducedata & pp(post-processor) #####
## PostProcessors: 
    # This is an operator that implements various algorithm functions for post-processing from raw data.
    # Operators(algorithm post-processing):
    # FirstFill, FirstSample, LastFill, LastSample, Nth, RMS, Skewness, Count, NCount, 
    # Mean, Min, Max, Median, PopulationVariance, Variance, Jitter, Kurtosis, StandardDeviation,
    # LinearInterpolation, LoessInterpolation, Optimized, OptimizedWithLastSample, ErrorBars,
    # Fliers, Statistics, IgnoreFliers

## reducedata:
    # When moving and loading data in the ETL module, the algorithms of multiple post-processors are applied to save storage capacity 
    # and maximize the performance of data retrieval services.
    # Based on all postprocessor algorithms, summary the important things to consider when setting up 'reducedata' into 4 key topics.
    #   1. Control: 'Interval time' vs 'Data count'
    #       * Interval time: e.g.) mean_300, firstFill_300, median_300
    #           - Meaning: Divide the data into 300-second time interval.
    #           - 300 second time interval = 1 hour query((60*60)/300=12 count), 24 hour query((24*60*60)/300 = 288 count)
    #           - mean, firstFill, median, ... except optimized, 

    #       * Count : e.g.) optimized_500, optimizedWithLastSample_500
    #           - Meaning: Regardless of the query time, set the final result to 500.
    #           - Note: The final number of data points (e.g., 500) is fixed, but the time size of the bins continuously changes 
    #                    depending on the total query time (1-hour=7.2(3600/500) seconds, 24-hour=172.8(86,400/500) seconds)

    #   2. Purpose of processing: What to see?
    #       : Depending on the purpose of data reduction, completely different algorithms should be chosen.

    #     2-1. Simple sampling (representative point extraction)
    #       : FirstSample(FirstFill), LastSample(LastFill), Nth: regardless of time, n-th sample
    #     2-2. Statistical summary (interval compression)
    #       : Central Tendency: Mean (average), Median (median, robust to outliers)
    #       : Volatility/Stability: Variance, Jitter, and ErrorBars
    #       : Distribution shape (advanced analysis): Kurtosis (peakiness, outlier frequency), Skewness (asymmetry)
    #     2-3. Data Cleaning (filtering)
    #       : IgnoreFliers: Remove statistical outliers (outliers) to see only clean data.
    #       : Fliers: Analyze errors or events by extracting only statistical outliers.
    #     2-4. Interpolation and Smoothing (Gap Filling)
    #       : FirstFill, OptimizedWithLastSample: Fills empty intervals with previous values (LOCF) to ensure continuity.   
    #       : LinearInterpolation, LoessInterpolation: Resample irregular data into data with regular time intervals. 
    #           Loess is specialized for drawing smooth trend lines that remove noise.

    #   3. Tradeoffs: Performance vs Statical Features
    #     3-1. High performance/low memory (using SummaryStatistics)
    #       : Min, Mean, Variance, Jitter, Statistics, ErrorBars, ...
    #     3-2. High cost/high memory (using DescriptiveStatistics or List)
    #       : Median, Kurtosis, Skewness, LinearInterpolation, LoessInterpolation

    #   4. The Importance of Handling Data Gaps
    #       : It is very important to decide how to handle gaps where there is no data.
    #       : FirstSample, LastSample (No fill for empty data)
    #       : FirstFill, LastFill (Fill with the previous value for empty data)

## pp:
    # pp settings default to saving raw data.
    # The pb file for pp settings is saved as a separate file.
    # When data retrieval is performed, if the post processor matches exactly, data is fetched from the file.
    # ‘pp’(Post-Processor): This feature pre-calculates and caches frequently used post-processing results (e.g., average, RMS) 
    # during data retrieval during the ETL process. This significantly improves data retrieval performance.
    # However, ‘pp’ property and ‘reducedata’ property cannot be set at the same time.
    # ‘pp’ property stores cached data in a separate file.  
    # e.g,) "pp=mean_30" or "pp=firstSample_30"
    # Analog15:2025_10_13_14.mean_30 or Analog15:2025_10_13_14.firstSample_30

    # Continuous setting
    # Setting more than one 'pp' parameter
    # e.g,) "pp=ignoreflyers_30_3&mean_60"  // After filtering the outlier data for 3 sigma for a time interval of 30 seconds, mean(30) post-processor is applied.

    # Optimization 'pp' parameter setting for statistical data.
    # e.g,) "pp=stats_60",      // Statistical data includes {mean,standard deviation,minimum,maximum,and count} values by order.
    # In the case of statistical data (stats), it is important to know the extraction order when extracting data(also errorbar). 

    # Data move via ETL
    # 'pp' settings can be set in MTS and LTS areas. However, the ETL data moving policy does not apply. 

    # partitionGranularity 
    #

    # Note: 
    # reducedata: Unlike PP, the original data is replaced with post-processed data during the ETL process and stored. 
    # This saves storage space, but the original data is lost.
    # The best post processor for pp settings is stats, which contains the most information.

    

######

###### hold & gather #####
## hold: 
    # This parameter is related to the 'partitionGranularity' setting.
    # Defines the period of time for which granuality files are maintained in the storage areas(STS,MTS,LTS). 
    # After this period, the files are moved to their destination(STS=>MTS, MTS=>LTS)
    # For example, the setting 'hold=6' means that 5 pb files will be kept in the current storage area and then moved by the ETL module.

## gather: 
    # This parameter is related to the 'partitionGranularity' and 'hold' setting.
    # Defines the number of granularity file unit to be moved in the given storage area.
    # For example, a setting of 'gather=4' will move 4 'pb' files at a time when the pb file time expires in the current storage area.

    # Note: The number of gathers cannot exceed the number of holds.
    #       The hold number is always greater than the gather number.

######

##### without hold & gather #####
  ## The pb (protocol buffer) file corresponding to the EPICS Process Variable is created irregularly.
  ## This causes irregular movement of pb data files by ETL, and the resulting data display may become inconsistent.

######

##### with hold & gather #####
  ## Data movement and data display can be done consistently.
  ## In case using “hold count” with large number, When data extraction requires optimized reading performance from storage media.
  ## In case gather > hold  => IOException

##### optimized number for (hold, gather) #####
  ## The setting “hold=2&gather=1” is the smoothest setting for ETL data movement and data display.
  ## In case “STS and MTS” storage media are the same


##### Storage Media #####
  ## SATA Disk: Local Disk(STS/MTS), LTS(Storage F.S - memory based as possible)
    #   STS : 
	#       - RAM file system(Memory Mapped I/O to Disk, Greater than 64GB RAM)  => Consider total PV volume
	#       - P_Granularity : HOUR,  hold: 5, gather: 1
    #   MTS:  P_Granularity : DAY,  hold: 2, gather: 1
    #   LTS : P_Granularity : MONTH


  ## NVMe(M.2): Local Disk(STS/MTS), LTS(Storage F.S - memory based as possible)
    #   STS : P_Granularity : DAY,  hold: 2, gather: 1
    #   MTS : P_Granularity : MONTH,  hold: 2, gather: 1
    #   LTS : P_Granularity : YEAR (Live),  1yr, 3yr, 5yr / experiment  => move recovery storage


