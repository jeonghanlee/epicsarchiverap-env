
SYSTEMD_PATH:=/etc/systemd/system
SYSTEMD_OVERRIDE_FILENAME:=override.conf
SYSTEMD_FILENAME:=${APPNAME}.service
SYSTEMD_HEALTH_SERVICE:=${APPNAME}-health.service
SYSTEMD_HEALTH_TIMER:=${APPNAME}-health.timer
# Seconds; site overrides may be set in CONFIG_SITE.local.
SYSTEMD_HEALTH_STARTUP_SECONDS?=60
SYSTEMD_HEALTH_INTERVAL_SECONDS?=30
SYSTEMD_HEALTH_ACCURACY_SECONDS?=1
SYSTEMD_HEALTH_TIMEOUT_SECONDS?=5
SYSTEMD_HEALTH_STOP_SECONDS?=1
# Ordered stop of the four Tomcats, including the ETL consolidation on shutdown.
SYSTEMD_TIMEOUT_STOP_SECONDS?=300
