
### Toolchain paths (overridable via CONFIG_SITE.local or configure/os/*.mk)
## The JDK is the distro package from configure/os/<os>.pkgs; Maven comes
## from the source repository's Maven Wrapper (see MAVEN_CMD in CONFIG_SRC).
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ANT_HOME=/usr/share/ant
TOMCAT_HOME=/opt/tomcat9

JAVA_PATH=$(JAVA_HOME)/bin
ANT_PATH=$(ANT_HOME)/bin

### MariaDB defaults (overridable via CONFIG_SITE.local)
## MariaDB is expected to listen on the loopback only (127.0.0.1); exposing it
## to non-loopback hosts must be configured manually
## Local-only admin path (make db.secure/addAdmin/create); replaced by the
## provisioning operator. The application connection uses DB_HOST_NAME (127.0.0.1).
DB_ADMIN_HOST=localhost
DB_HOST_IPADDR=127.0.0.1
DB_HOST_PORT=3306
DB_HOST_NAME=127.0.0.1
DB_ADMIN=admin
DB_ADMIN_PASS=admin
DB_NAME=archappl
DB_USER=archappl
DB_USER_PASS=archappl
DB_BACKUP_PATH=db

ARCHAPPL_HOST_IPADDR=localhost

### ArchiverAppliance Configuration Path

AA_INSTALL_PATH=/opt
AA_INSTALL_LOCATION=${AA_INSTALL_PATH}/${APPNAME}
AA_SITE_TEMPLATE_PATH=$(TOP)/site-template

ARCHAPPL_TOP:=$(AA_INSTALL_LOCATION)
ARCHAPPL_SITEID:=als
ARCHAPPL_VERSION:=$(SRC_VERSION)-$(ARCHAPPL_SITEID)
ARCHAPPL_WARS_TARGET_PATH=$(TOP)/$(SRC_PATH)/target
ARCHAPPL_SITEID_TEMPATE_PATH:=$(AA_SITE_TEMPLATE_PATH)/siteid
ARCHAPPL_SITEID_CLASSPATHFILES_PATH:=$(ARCHAPPL_SITEID_TEMPATE_PATH)/classpathfiles

ANT_OPTS:=-Dant.home=$(ANT_HOME)
ANT_OPTS+=-Dant.library.dir=$(ANT_HOME)/lib
#ANT_OPTS+=--execdebug
ANT_OPTS+=-Dver=$(ARCHAPPL_VERSION)
ANT_OPTS+=-Dwardest=$(ARCHAPPL_WARS_TARGET_PATH)
ANT_OPTS+=-Dtomcathome=$(TOMCAT_HOME)
ANT_OPTS+=-Darchapplsite=$(ARCHAPPL_SITEID)

## Maven command-line flags, such as -B or -gs /absolute/path/settings.xml.
## MAVEN_OPTS is Maven's JVM-options environment variable, not this Make hook.
MAVEN_FLAGS:=

## Per-instance defaults for VM testing; CONFIG_SRC uses the heap for Xms and Xmx.
## Four instances: 4 * 256 MiB heap = 1 GiB; metaspace caps add another 1 GiB.
## The combined 2 GiB is not a process-memory cap; allow additional memory for
## JVM native allocations, MariaDB and the OS. Validate with the intended PV load.
## Override AA_JAVA_HEAPSIZE in ../CONFIG_SITE.local for the measured workload.
AA_JAVA_HEAPSIZE="256M"
AA_JAVA_MAXMETASPACE="256M"
# https://stackoverflow.com/questions/58991966/what-java-security-egd-option-is-for
# https://www.openssl.org/blog/blog/2017/08/12/random/
# AA_JAVA_OPTS="-Djava.security.egd=file:/dev/./urandom"
# For Java 21, we don't need this anymore.
AA_JAVA_OPTS=""
#
AA_USERID:=tomcat
AA_GROUPID:=$(AA_USERID)

## appliances.xml
#
ARCHAPPL_STORAGE_TOP=/arch
ARCHAPPL_SHORT_TERM_FOLDER:=$(ARCHAPPL_STORAGE_TOP)/sts/ArchiverStore
ARCHAPPL_MEDIUM_TERM_FOLDER:=$(ARCHAPPL_STORAGE_TOP)/mts/ArchiverStore
ARCHAPPL_LONG_TERM_FOLDER:=$(ARCHAPPL_STORAGE_TOP)/lts/ArchiverStore
## Store partition granularity and ETL hold per tier, rendered into
## $(ARCHAPPL_POLICIES). A granularity must be one of the PartitionGranularity
## names in the source (PARTITION_5MIN, PARTITION_15MIN, PARTITION_30MIN,
## PARTITION_HOUR, PARTITION_DAY, PARTITION_MONTH, PARTITION_YEAR); a hold must
## be a positive integer. A test host shortens the chain in ../CONFIG_SITE.local.
ARCHAPPL_STS_GRANULARITY:=PARTITION_HOUR
ARCHAPPL_STS_HOLD:=2
ARCHAPPL_MTS_GRANULARITY:=PARTITION_DAY
ARCHAPPL_MTS_HOLD:=2
ARCHAPPL_LTS_GRANULARITY:=PARTITION_YEAR

## archappl.properties
## We only have three variables for the space holder for the future expansion
#
ARCHAPPL_MINIMUM_SAMPLING_PERIOD:=0.1
ARCHAPPL_SECONDS_TO_BUFFER:=10
ARCHAPPL_SAMPLE_BUFFER_CAPACITY_ADJUSTMENT:=1.0


ARCHAPPL_SINGLE_IDENTITY=appliance0
## The following three files will in $(AA_INSTALL_LOCATION)
#
ARCHAPPL_APPLIANCES:=appliances.xml
ARCHAPPL_CONF:=archappl.conf
## WAR/WEB-INF/classes
## RULES_INSTALL
ARCHAPPL_POLICIES:=policies.py
ARCHAPPL_PROPERTIES:=archappl.properties
## Root level of the WAR and Tomcat log4j2 configurations, exported to the
## JVMs through archappl.conf; set it in ../CONFIG_SITE.local.
ARCHAPPL_ROOT_LOGGER_LEVEL:=INFO
## A site log4j2 configuration outside the WAR; empty keeps the WAR's own file.
## Set it in ../CONFIG_SITE.local to an absolute path on the appliance host.
ARCHAPPL_LOG4J_SITE_FILE:=
## $(AA_INSTALL_LOCATION)/*/conf
#
ARCHAPPL_CONTEXT_XML:=context.xml
ARCHAPPL_TOMCAT_STARTUP:=startup.sh
ARCHAPPL_TOMCAT_SHUTDOWN:=shutdown.sh
ARCHAPPL_TOMCAT_RUN:=run.sh
ARCHAPPL_TOMCAT_SETENV:=setenv.sh
## log4j-api, log4j-core, log4j-appserver and log4j-jul, written by the source
## build next to the WARs; each instance loads them from $(CATALINA_BASE)/log4j.
ARCHAPPL_TOMCAT_LOG4J_PATH=$(ARCHAPPL_WARS_TARGET_PATH)/tomcat-log4j
ARCHAPPL_MAIN_SCRIPT:=archappl.bash


# SYSTEDM Required and After Service List
# This is After and Required services for the systemd archiver appliance systemd service.
# mariadb.service was defined in there, but sometimes, we need to check our directories where
# our data will be saved.
# one can check the mounting service name through  `systemctl list-units --type=mount`
# Here is the example for the ALS environment
# CONFIG_SITE.local can be used to hold this information locally
# Each service need one space between them, and backslash must be double backslash
#
# SYSTEMD_SERVICES=archappl.mount home-als1.mount remote-als\\x2dsw.mount
SYSTEMD_SERVICES:=

# These allow developers to override the CONFIG_SITE variable
# settings without having to modify the configure/CONFIG_SITE
# file itself.
-include $(TOP)/../CONFIG_SITE.local
-include $(TOP)/configure/CONFIG_SITE.local
