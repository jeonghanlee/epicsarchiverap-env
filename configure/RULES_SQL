# RULES_SQL
sql_db_RULES_NAMES:=conf secure addAdmin rmAdmin conf.show create drop show
sql_db_RULES:=$(addprefix db., $(sql_db_RULES_NAMES))

# Helpers receive the same backend selection as the invoking Make target.
DATABASE_SETTINGS_KEYS := DB_BACKEND DB_ADMIN_HOST DB_ADMIN DB_ADMIN_PASS DB_HOST_NAME DB_HOST_IPADDR DB_NAME DB_HOST_PORT DB_USER DB_USER_PASS DB_SOCKET ARCHAPPL_SQLITE_FILE AA_USERID AA_GROUPID AA_SITE_TEMPLATE_PATH SYSTEMD_FILENAME SYSTEMD_HEALTH_SERVICE SYSTEMD_HEALTH_TIMER
export $(DATABASE_SETTINGS_KEYS)
export AA_DATABASE_SETTINGS_READY := 1
.PHONY: _database.settings
_database.settings:
	@printf '%s\0' $(foreach key,$(DATABASE_SETTINGS_KEYS),"$$$(key)")
.PHONY: $(sql_db_RULES)

ifeq "$(DB_BACKEND)" "sqlite"
db.conf db.conf.show:
	$(QUIET)printf '[SKIP] %s: MariaDB setup is not needed for DB_BACKEND=sqlite.\n' "$@"
db.secure db.addAdmin db.rmAdmin:
	$(error $@ is not supported for DB_BACKEND=sqlite)
db.create: mariadb_setup.bash
	$(QUIET)bash -p $< dbCreate
db.drop: mariadb_setup.bash
	$(QUIET)bash -p $< dbDrop
db.show: mariadb_setup.bash
	$(QUIET)bash -p $< dbShow
else ifeq "$(DB_BACKEND)" "mariadb"
db.conf: export RENDER_DB_BACKEND = $(DB_BACKEND)
db.conf: export RENDER_DB_ADMIN_HOST = $(DB_ADMIN_HOST)
db.conf: export RENDER_DB_ADMIN = $(DB_ADMIN)
db.conf: export RENDER_DB_ADMIN_PASS = $(DB_ADMIN_PASS)
db.conf: export RENDER_DB_HOST_NAME = $(DB_HOST_NAME)
db.conf: export RENDER_DB_HOST_IPADDR = $(DB_HOST_IPADDR)
db.conf: export RENDER_DB_NAME = $(DB_NAME)
db.conf: export RENDER_DB_HOST_PORT = $(DB_HOST_PORT)
db.conf: export RENDER_DB_USER = $(DB_USER)
db.conf: export RENDER_DB_USER_PASS = $(DB_USER_PASS)
db.conf: export RENDER_DB_SOCKET = $(strip $(DB_SOCKET))
db.conf: $(SQL_CONFIG_FILE).in
	$(call checkfile,$(AA_SITE_TEMPLATE_PATH)/$(SQL_CONFIG_FILE))
	$(QUIET) echo ">>> Generate $(AA_SITE_TEMPLATE_PATH)/$(SQL_CONFIG_FILE)"
	$(QUIET)umask 077; bash $(TOP)/scripts/render-db-config.bash shell "$<" "$(basename $<)" DB_BACKEND DB_ADMIN_HOST DB_ADMIN DB_ADMIN_PASS DB_HOST_NAME DB_HOST_IPADDR DB_NAME DB_HOST_PORT DB_USER DB_USER_PASS DB_SOCKET

db.conf.show:
	$(QUIET)cat -b $(AA_SITE_TEMPLATE_PATH)/$(SQL_CONFIG_FILE)

db.secure: mariadb_setup.bash db.conf
	$(QUIET)bash -p $< secureSetup

db.addAdmin: mariadb_setup.bash db.conf
	$(QUIET)bash -p $< adminAdd

db.rmAdmin: mariadb_setup.bash db.conf
	$(QUIET)bash -p $< adminRemove

# Create DB : DB_NAME
db.create: mariadb_setup.bash db.conf
	$(QUIET)echo "\n>>> Create $(DB_NAME) with $(DB_USER)"
	$(QUIET)bash -p $< dbUserCreate

# Drop DB and DB USER
db.drop: mariadb_setup.bash db.conf
	$(QUIET)bash -p $< dbUserDrop

db.show: mariadb_setup.bash db.conf
	$(QUIET)bash -p $< dbShow

else
$(sql_db_RULES):
	$(error DB_BACKEND must be one of: $(DB_BACKENDS) (got '$(DB_BACKEND)'))
endif

#sed "s/CREATE TABLE /CREATE TABLE IF NOT EXISTS /g" ${aa_deploy_db_tables} > ${aa_deploy_db_tables_new};

sql_sql_RULES_NAMES:=fill show update update.show table.fill table.show drop table.drop
sql_sql_RULES:=$(addprefix sql., $(sql_sql_RULES_NAMES))
.PHONY: $(sql_sql_RULES)

sql.fill: sql.update sql.table.fill

sql.show: sql.table.show

.PHONY: sql.drop sql.table.drop
sql.drop: sql.table.drop

# The schema load writes aa-env's modified copy of the source schema, with
# every CREATE guarded by IF NOT EXISTS, and loads it into the selected backend,
# so a second run is harmless and restores a missing table. SQLite first makes
# sure the service account exists (src_preinst), then runs sqlite3 as that
# account through the validated database helper and feeds the schema on standard
# input, since that account may not read a checkout under a private home.
# sql.update removes the rendered copy before it writes it, so that a copy left
# owned by root in the checkout does not stop the checkout owner; the removal
# runs only on a non-empty path and stops the rule otherwise.
ifeq "$(DB_BACKEND)" "sqlite"
sql.update:
	$(QUIET)test -n "$(SQL_AA_UPDATE_SQLITE)" && rm -f -- "$(SQL_AA_UPDATE_SQLITE)"
	$(QUIET)sed -e "s/CREATE TABLE /CREATE TABLE IF NOT EXISTS /g" \
	            -e "s/CREATE TRIGGER /CREATE TRIGGER IF NOT EXISTS /g" \
	            < $(SQL_AA_ORIG_SQLITE) > $(SQL_AA_UPDATE_SQLITE)

sql.update.show:
	$(QUIET)echo ">>> $(SQL_AA_UPDATE_SQLITE)"
	$(QUIET)cat -b $(SQL_AA_UPDATE_SQLITE)

# sql.table.fill loads the schema that sql.update rendered; it renders nothing,
# so that a root run writes nothing into the checkout. The check runs before
# src_preinst, so a missing or stale schema stops before the account is touched.
sql.table.fill: mariadb_setup.bash
	$(call require_rendered,$(SQL_AA_UPDATE_SQLITE),$(SQL_AA_ORIG_SQLITE),sql.update,$(SQL_AA_ORIG_SQLITE))
	$(QUIET)$(MAKE) src_preinst
	$(QUIET)bash -p $< queryFile "$(SQL_AA_UPDATE_SQLITE)"

sql.table.show: mariadb_setup.bash
	$(QUIET)bash -p $< tableShow
else ifeq "$(DB_BACKEND)" "mariadb"
sql.update:
	$(QUIET)test -n "$(SQL_AA_UPDATE_SQL)" && rm -f -- "$(SQL_AA_UPDATE_SQL)"
	$(QUIET)sed -e "s/CREATE TABLE /CREATE TABLE IF NOT EXISTS /g" \
	            -e "s/) ENGINE=InnoDB;/) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;/g" \
	            < $(SQL_AA_ORIG_SQL) > $(SQL_AA_UPDATE_SQL)

sql.update.show:
	$(QUIET)echo ">>> $(SQL_AA_UPDATE_SQL)"
	$(QUIET)cat -b $(SQL_AA_UPDATE_SQL)

sql.table.fill: mariadb_setup.bash
	$(call require_rendered,$(SQL_AA_UPDATE_SQL),$(SQL_AA_ORIG_SQL),sql.update,$(SQL_AA_ORIG_SQL))
	$(QUIET)bash -p $< "queryFile" "$(SQL_AA_UPDATE_SQL)"

sql.table.show: mariadb_setup.bash
	$(QUIET)echo "\n>>> $(DB_NAME) Tables"
	$(QUIET)bash -p $< tableShow
else
sql.update sql.update.show sql.table.fill sql.table.show:
	$(error DB_BACKEND must be one of: $(DB_BACKENDS) (got '$(DB_BACKEND)'))
endif

aa_tables_RULES:=PVRequests.show DataServers.show PVAliases.show PVTypeInfo.show
.PHONY: $(aa_tables_RULES)

ifneq ($(filter x$(DB_BACKEND)x,xmariadbx xsqlitex),)
sql.table.drop: mariadb_setup.bash
	$(QUIET)echo "\n>>> $(DB_NAME) Tables Drop"
	$(QUIET)bash -p $< tableDrop

PVRequests.show: mariadb_setup.bash
	$(QUIET)bash -p $< "aaShow" "ArchivePVRequests"

DataServers.show: mariadb_setup.bash
	$(QUIET)bash -p $< "aaShow" "ExternalDataServers"

PVAliases.show: mariadb_setup.bash
	$(QUIET)bash -p $< "aaShow" "PVAliases"

PVTypeInfo.show: mariadb_setup.bash
	$(QUIET)bash -p $< "aaShow" "PVTypeInfo"
else
sql.table.drop $(aa_tables_RULES):
	$(error DB_BACKEND must be one of: $(DB_BACKENDS) (got '$(DB_BACKEND)'))
endif
